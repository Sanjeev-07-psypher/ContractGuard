# Copy to .env and fill in. Never commit .env.
# LLM_PROVIDER: gemini (default), ollama (local), mock (tests), none (template explanations only)
LLM_PROVIDER=gemini
# Gemini: pick the current Flash / Flash-Lite model listed in Google AI Studio.
# Ollama: e.g. llama3.1:8b or qwen2.5:7b (CG_LLM__OLLAMA_HOST defaults to http://localhost:11434).
LLM_MODEL=
GEMINI_API_KEY=
# Free-tier Gemini data may be used by Google: demo only with synthetic or public contracts.
